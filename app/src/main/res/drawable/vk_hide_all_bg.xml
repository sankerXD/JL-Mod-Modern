<?xml version="1.0" encoding="utf-8"?>
<!-- same translucent look as the virtual keys (vkBgColor 0xD0D0D0 @ alpha 64,
     white outline) so the toggle blends into the on-screen keyboard -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#40D0D0D0" />
    <stroke
        android:width="1dp"
        android:color="#80FFFFFF" />
    <corners android:radius="8dp" />
</shape>
